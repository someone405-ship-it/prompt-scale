{
  "manifest_version": 3,
  "name": "Prompt Scale",
  "version": "1.1.0",
  "description": "Token estimate on claude.ai. Anthropic official count optional. Store OpenAI/Groq/OpenRouter keys locally. Unofficial.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Prompt Scale"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://claude.ai/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
